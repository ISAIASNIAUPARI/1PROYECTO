# =============================================================
#  La Gloria Restaurante — variables de entorno
# =============================================================
# Copia este archivo como `.env.local` y rellena los valores.
# `.env.local` está en .gitignore: nunca se sube al repositorio.
# -------------------------------------------------------------


# --- Sanity: identificadores del proyecto -------------------
# Son PÚBLICOS (viajan al navegador). No son secretos.
# Los encuentras en https://www.sanity.io/manage → tu proyecto.

# ID del proyecto de Sanity (8 caracteres).
NEXT_PUBLIC_SANITY_PROJECT_ID="tu-project-id"

# Dataset a leer. En este proyecto es "production".
NEXT_PUBLIC_SANITY_DATASET="production"

# Versión de la API de Sanity, en formato fecha.
# No la cambies salvo que sepas lo que haces: fija el contrato de la API.
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-01"


# --- Sanity: tokens -----------------------------------------
# ⚠️ SECRETOS. No los publiques ni los subas a git.
# Se generan en https://www.sanity.io/manage → API → Tokens.

# Token de LECTURA (permiso "Viewer").
# Sólo hace falta si algún día lees contenido en borrador.
# La web pública funciona sin él.
SANITY_API_READ_TOKEN=""

# Token de ESCRITURA (permiso "Editor").
# Sólo lo usa el script de carga inicial (`npm run seed`).
# NO es necesario en Vercel para que la web funcione.
SANITY_API_WRITE_TOKEN=""
